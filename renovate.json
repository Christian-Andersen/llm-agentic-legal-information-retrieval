{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "nix": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Group all Nix flake lock input updates into a single PR and keep them out of automerge",
      "matchManagers": ["nix"],
      "groupName": "Nix flake inputs",
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track pinned hook revisions (rev) of remote hook repos in prek.toml",
      "fileMatch": ["(^|/)prek\\.toml$"],
      "matchStrings": [
        "repo\\s*=\\s*[\"']https://github\\.com/(?<depName>[^/\"']+/[^/\"']+)[\"'][^\\[]*?rev\\s*=\\s*[\"'](?<currentValue>[^\"']+)[\"']"
      ],
      "datasourceTemplate": "github-tags"
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on the first day of the month"]
  }
}
